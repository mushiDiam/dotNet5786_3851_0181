<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In" Height="380" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Time / Accent Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PasswordBox simple style to match TextBox look -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#1565C0" Height="100" VerticalAlignment="Top">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Sign in" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Enter your credentials to continue" FontSize="12" Foreground="#E3F2FD"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Card: positioned BELOW the header to avoid overlap -->
        <Border Background="White" CornerRadius="8" Padding="20" Width="420"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,79,0,0" Height="275">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- title -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- inputs (stacked vertically) -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- buttons -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- status -->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Grid.Row="0">
                    <TextBlock Text="Sign in to your account" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#333"/>
                    <TextBlock Text="Provide your ID and password" FontSize="12" Foreground="#666"/>
                </StackPanel>

                <!-- Inputs: ID above Password -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,6,0,0">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock Text="ID:" Foreground="#333" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtId" Height="34" VerticalAlignment="Top" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Password:" Foreground="#333" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="pwdBox" Height="34" VerticalAlignment="Top" Style="{StaticResource ModernPasswordBox}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Buttons: below the password box, smaller -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Cancel" Width="84" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click" Style="{StaticResource DangerButton}"/>
                    <Button Content="Sign In" Width="96" Height="32" Click="BtnLogin_Click" Style="{StaticResource ModernButton}"/>
                </StackPanel>

                <TextBlock Grid.Row="6" x:Name="txtStatus" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
