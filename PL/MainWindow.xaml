<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Courier Management System" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="White">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#C71585"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Courier Management System - Main Dashboard" 
                   HorizontalAlignment="Center" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,30"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,40,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Max Delivery Window: " 
                               Foreground="Blue" 
                               FontSize="16" 
                               VerticalAlignment="Center"/>

                    <TextBox Text="{Binding Configuration.DeliveryWindow, Mode=TwoWay}" 
                             Width="60" 
                             Style="{StaticResource InputBox}"
                             Margin="10,0"/>

                    <Button Content="Update" 
                            Click="UpdateButton_Click" 
                            Style="{StaticResource ModernButton}"/>
                </StackPanel>

                <TextBlock Text="[The maximum time window for delivery,&#x0a;After that the parcel becomes Overdue]" 
                           Foreground="#9932CC" 
                           FontSize="14" 
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Blue" BorderThickness="2" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel Width="280">
                    <Border Background="#00BFFF" Padding="10" Margin="0,0,0,5">
                        <TextBlock Text="{Binding CurrentClock, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="Black"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel>
                        <Button Content="Add One Minute" Click="btnAddOneMinute_Click" Style="{StaticResource ModernButton}" Margin="0,1"/>
                        <Button Content="Add One Hour" Click="btnAddOneHour_Click" Style="{StaticResource ModernButton}" Margin="0,1"/>
                        <Button Content="Add One Day" Click="btnAddOneDay_Click" Style="{StaticResource ModernButton}" Margin="0,1"/>
                        <Button Content="Add One Month" Click="btnAddOneMonth_Click" Style="{StaticResource ModernButton}" Margin="0,1"/>
                        <Button Content="Add One Year" Click="btnAddOneYear_Click" Style="{StaticResource ModernButton}" Margin="0,1"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="1" Rows="2" VerticalAlignment="Bottom">
                <Button Content="Reset DB" 
                        Click="btnResetDB_Click"
                        Height="50" Width="180"
                        Margin="0,0,0,20"
                        Style="{StaticResource ModernButton}"/>

                <Button Content="Init DB" 
                        Click="btnInitializeDB_Click"
                        Height="50" Width="180"
                        Style="{StaticResource ModernButton}"/>
            </UniformGrid>

            <UniformGrid Grid.Column="2" Columns="1" Rows="2" VerticalAlignment="Bottom">
                <Button Content="Handle Couriers" 
                        Click="btnHandleCouriers_Click"
                        Height="50" Width="180"
                        Style="{StaticResource ModernButton}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>