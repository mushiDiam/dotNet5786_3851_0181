<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL.Helpers"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <local:OrderTypesCollection x:Key="BO:orderTypes" />
        <local:EndTypesCollection x:Key="EndTypesKey" />
        <local:ScheduleStatusCollection x:Key="ScheduleStatusKey" />
        <local:OrderStatusCollection x:Key="OrderStatusKey" />
        <local:TransportationCollection x:Key="TransportationKey" />
        <local:JobTypesCollection x:Key="JobTypesKey" />
        <local:OrderInListOptionsCollection x:Key="OrderInListOptionsKey" />
        <local:CourierInListOptionsCollection x:Key="CourierInListOptionsKey" />
        <local:TimesCollection x:Key="TimesKey" />

        <local:ModeToReadOnlyConverter x:Key="ConvertUpdateToTrueKey"/>
        <local:ModeToVisibilityConverter x:Key="ConvertUpdateToVisibleKey"/>
        <local:StatusToIconConverter x:Key="StatusToIconKey"/>

        <local:BoolToVisibilityInverseConverter x:Key="InverseBoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
    </Application.Resources>
</Application>