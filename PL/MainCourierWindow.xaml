<Window x:Class="PL.MainCourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Time Control Button Style -->
        <Style x:Key="TimeButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header Bar -->
        <Border Background="#1565C0" Height="120" VerticalAlignment="Top">
            <Grid Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Section: Title and Courier Info -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Courier Dashboard" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock Text="Personal workspace — manage profile, pick orders and view history" 
                                       FontSize="12" 
                                       Foreground="#E3F2FD"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Courier Display in Header -->
                    <Border Background="#0D47A1" 
                            CornerRadius="8" 
                            Padding="20,10" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="SIGNED IN AS" 
                                       FontSize="10" 
                                       Foreground="#90CAF9" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CurrentCourier.FullName}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCourier.Id, StringFormat='ID: {0}'}"
                                       FontSize="12"
                                       Foreground="#BBDEFB"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Section: small actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="Refresh" 
                            Click="BtnRefresh_Click" 
                            Style="{StaticResource TimeButton}"
                            Margin="0,0,8,0"
                            Padding="12,6"/>
                    <Button Content="Save Profile" 
                            Click="BtnSave_Click" 
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            Padding="12,6"/>
                    <Button Content="Choose Order" 
                            Click="BtnChooseOrder_Click" 
                            Style="{StaticResource ModernButton}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="20,140,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="🔧 Quick Actions" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"
                               Foreground="#333333"/>

                    <Button Content="My Profile" Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                    <Button Content="Available Orders" Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                    <Button Content="Delivery History" Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                    <Button Content="Logout" Click="BtnLogout_Click" Style="{StaticResource DangerButton}" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right Panel - Courier Content -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="🚚" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="My Workspace" 
                                   FontSize="20" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#333333"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Profile Panel -->
                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                    <TextBlock Text="PROFILE" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="90" Text="Full Name:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="90" Text="Phone:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="90" Text="Transport:" VerticalAlignment="Center"/>
                                        <ComboBox Width="200"
                                                  ItemsSource="{StaticResource TransportationKey}"
                                                  SelectedItem="{Binding CurrentCourier.Transport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="90" Text="Join Date:" VerticalAlignment="Center"/>
                                        <DatePicker SelectedDate="{Binding CurrentCourier.JoinDate, Mode=TwoWay}" Width="200"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Current delivery summary -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <TextBlock Text="CURRENT DELIVERY" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SelectedOpenOrder.OrderId, StringFormat='Order ID: {0}'}" FontSize="13" Margin="0,2"/>
                                    <TextBlock Text="{Binding SelectedOpenOrder.FullAddress, StringFormat='Address: {0}'}" FontSize="13" Margin="0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedOpenOrder.ScheduleStatus, StringFormat='Status: {0}'}" FontSize="13" Margin="0,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Orders and History -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Open / Available Orders -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Open / Available Orders" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding OpenOrders}" AutoGenerateColumns="False" SelectionMode="Single"
                                          SelectedItem="{Binding SelectedOpenOrder, Mode=TwoWay}" Height="250" MouseDoubleClick="OpenOrders_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="OrderId" Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>
                                        <DataGridTextColumn Header="Distance" Binding="{Binding Distance, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Choose Order" Width="110" Click="BtnChooseOrder_Click" Style="{StaticResource ModernButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- History -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Delivery History" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding EndedDeliveries}" AutoGenerateColumns="False" SelectionMode="Single"
                                          SelectedItem="{Binding SelectedEndedDelivery, Mode=TwoWay}" Height="250" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DeliveryId" Binding="{Binding Id}" Width="90"/>
                                        <DataGridTextColumn Header="OrderId" Binding="{Binding OrderId}" Width="80"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="Delivered At" Binding="{Binding EndTime}" Width="160"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
