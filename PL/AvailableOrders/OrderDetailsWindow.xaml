<Window x:Class="PL.AvailableOrders.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.AvailableOrders"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Details" Height="520" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <ObjectDataProvider x:Key="OrderTypesCollection" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:OrderTypes"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#1565C0" CornerRadius="8" Grid.Row="0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Order Details" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Complete information about the selected order" FontSize="12" Foreground="#E3F2FD"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Order ID" Foreground="#BBDEFB" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Path=OrderId}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,12,0,39" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="MAIN" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Address:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FullAddress, Mode=TwoWay}" Width="220" Style="{StaticResource ModernTextBox}"
                                 IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Customer:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CustomerName, Mode=TwoWay}" Width="220" Style="{StaticResource ModernTextBox}"
                                 IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Phone:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CustomerPhone, Mode=TwoWay}" Width="220" Style="{StaticResource ModernTextBox}"
                                 IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Type:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource OrderTypesCollection}}" 
                                  SelectedItem="{Binding OrderType, Mode=TwoWay}"
                                  Width="220" 
                                  IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Fragile:" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding Fragile, Mode=TwoWay}" IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Weight:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Weight, Mode=TwoWay}" Width="220" Style="{StaticResource ModernTextBox}"
                                 IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="120" Text="Volume:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Volume, Mode=TwoWay}" Width="220" Style="{StaticResource ModernTextBox}"
                                 IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <TextBlock Text="Description" FontWeight="Bold" Foreground="#1565C0" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding Description, Mode=TwoWay}" Style="{StaticResource ModernTextBox}" Height="90" TextWrapping="Wrap"
                             IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="TIMING AND STATUS" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Created At:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Expected:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExpectedDeliveryTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Max Delivery:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MaxDeliveryTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Order Status:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OrderStatus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Schedule Status:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ScheduleStatus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Width="150" Text="Remaining Time:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RemainingTime}" />
                    </StackPanel>

                    <TextBlock Text="DELIVERIES" FontWeight="Bold" Foreground="#1565C0" Margin="0,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding Deliveries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="4" Padding="8" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeliveryId, StringFormat='Delivery #{0}'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StartDeliveryTime, StringFormat='Started: {0:dd/MM/yyyy HH:mm}'}" />
                                        <TextBlock Text="{Binding EndTime, StringFormat='Ended: {0:dd/MM/yyyy HH:mm}'}" />
                                        <TextBlock Text="{Binding OrderStatus, StringFormat='Status: {0}'}" />
                                        <TextBlock Text="{Binding ActualDistance, StringFormat='Distance: {0} km'}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Width="100"/>
            <Button Content="Accept Order" 
                    Click="BtnAccept_Click" 
                            Style="{StaticResource SuccessButton}" 
                            Width="120" 
                            Visibility="{Binding Path=AcceptVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Button Content="Delete" 
                            Click="BtnDelete_Click" 
                            Style="{StaticResource DangerButton}" 
                            Width="100" 
                            Visibility="{Binding Path=DeleteVisibility, RelativeSource={RelativeSource AncestorType=Window}}" 
                            Margin="8,0,0,0"/>

            <!-- Update button for manager. Enabled only when IsEditable (add-mode OR manager + open/in-progress) -->
            <Button x:Name="BtnUpdate"
                    Content="update"
                    Click="BtnUpdate_Click"
                    Style="{StaticResource SuccessButton}"
                    Width="120"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="Collapsed"
                    ToolTip="לא ניתן לעדכן — ההזמנה סגורה"/>

            <Button Content="Add Order" Click="BtnSave_Click" Style="{StaticResource SuccessButton}" Width="120" Visibility="Collapsed" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>