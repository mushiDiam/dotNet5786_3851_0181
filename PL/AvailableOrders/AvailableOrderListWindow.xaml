<Window x:Class="PL.AvailableOrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Available Orders" Height="520" Width="820"
        WindowStartupLocation="CenterOwner" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="#1565C0" Height="96" VerticalAlignment="Top">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Available Orders" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Orders you can choose to deliver" FontSize="12" Foreground="#E3F2FD"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="White" CornerRadius="10" Padding="18" Margin="20,120,20,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Select an order to accept" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid x:Name="dgOrders" Grid.Row="2" AutoGenerateColumns="False" MouseDoubleClick="DataGrid_MouseDoubleClick" CanUserAddRows="False" IsReadOnly="True" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OrderId" Binding="{Binding OrderId}" Width="90"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding FullAddress}" Width="*"/>
                        <DataGridTextColumn Header="Air (km)" Binding="{Binding AirDistance, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding ScheduleStatus}" Width="120"/>
                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingTime}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Width="110" Margin="0,0,8,0" Click="BtnRefresh_Click" Style="{StaticResource ModernButton}"/>

                    <Button Content="Choose Selected" 
                            Visibility="{Binding CourierVisibility}" 
                            Width="150" 
                            Margin="0,0,8,0" 
                            Click="BtnChoose_Click" 
                            Style="{StaticResource ModernButton}"/>

                    <Button Content="Close" Width="100" Click="BtnClose_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>