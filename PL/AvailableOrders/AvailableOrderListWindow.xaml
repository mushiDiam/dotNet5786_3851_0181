<Window x:Class="PL.AvailableOrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Available Orders" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" 
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" 
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#1565C0" Height="96" VerticalAlignment="Top">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Available Orders" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Orders you can choose to deliver" FontSize="12" Foreground="#E3F2FD"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="White" CornerRadius="10" Padding="18" Margin="20,120,20,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Select an order to accept / manage" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Sort By:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <ComboBox Width="120" Margin="0,0,15,0" 
                              ItemsSource="{Binding SortOptionsList}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              VerticalContentAlignment="Center"/>

                    <TextBlock Text="Filter Status:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <ComboBox Width="120" Margin="0,0,10,0" 
                              ItemsSource="{Binding StatusOptionsList}"
                              SelectedItem="{Binding SelectedFilterStatus, Mode=TwoWay}"
                              VerticalContentAlignment="Center"/>

                    <Button Content="Clear" Click="BtnClearFilters_Click" Style="{StaticResource ModernButton}" Height="28" Padding="10,2" FontSize="12"/>
                </StackPanel>

                <DataGrid Grid.Row="3" 
                          ItemsSource="{Binding OrdersList}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          MouseDoubleClick="DataGrid_MouseDoubleClick" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OrderId" Binding="{Binding OrderId}" Width="70"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding FullAddress}" Width="*"/>
                        <DataGridTextColumn Header="Air (km)" Binding="{Binding AirDistance, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding OrderStatus}" Width="100"/>
                        <DataGridTextColumn Header="Sched. Status" Binding="{Binding ScheduleStatus}" Width="100"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding RemainingTime}" Width="100"/>

                        <DataGridTemplateColumn Header="Cancel" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="CancelOrder_Click" Padding="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" Foreground="White"/>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Open">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="InProgress">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Width="110" Margin="0,0,8,0" Click="BtnRefresh_Click" Style="{StaticResource ModernButton}"/>

                    <Button Content="Choose Selected" 
                            Visibility="{Binding CourierVisibility}" 
                            Width="150" 
                            Margin="0,0,8,0" 
                            Click="BtnChoose_Click" 
                            Style="{StaticResource ModernButton}"/>

                    <Button Content="+ Add Order"
                            Visibility="{Binding ManagerVisibility}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="BtnAddOrder_Click"
                            Style="{StaticResource ModernButton}"/>

                    <Button Content="Close" Width="100" Click="BtnClose_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>