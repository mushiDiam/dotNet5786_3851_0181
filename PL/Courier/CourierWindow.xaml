<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="580" Width="450"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <ObjectDataProvider x:Key="TransportOptionsCollection" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:Transportation"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}" FontSize="24" FontWeight="Bold" 
                   Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Courier ID:"/>
                <TextBlock Text="Joined At:"/>
                <TextBlock Text="Full Name:"/>
                <TextBlock Text="Email:"/>
                <TextBlock Text="Phone Number:"/>
                <TextBlock Text="Password:"/>
                <TextBlock Text="Max Distance (km):"/>
                <TextBlock Text="Transportation:"/>
                <TextBlock Text="Active Status:"/>
            </StackPanel>

            <StackPanel Grid.Column="1">

                <TextBox Text="{Binding CurrentCourier.Id, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" 
                         IsEnabled="{Binding IsAddMode}"/>

                <DatePicker SelectedDate="{Binding CurrentCourier.JoinDate, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                            IsEnabled="{Binding IsAddMode}"/>

                <TextBox Text="{Binding CurrentCourier.FullName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.Email, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.Password, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.MaxDistancePreference, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <ComboBox ItemsSource="{Binding Source={StaticResource TransportOptionsCollection}}"
                          SelectedValue="{Binding CurrentCourier.Transport, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <CheckBox IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" 
                          Content="Is Active Courier" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding ButtonText}" Click="BtnSave_Click" 
                    Width="120" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

            <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="35"/>
        </StackPanel>
    </Grid>
</Window>