<Window x:Class="PL.Courier.ForManager.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        xmlns:local="clr-namespace:PL.Helpers" 
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="580" Width="450"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <ObjectDataProvider x:Key="TransportOptionsCollection" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:Transportation"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" 
                            Value="{Binding RelativeSource={RelativeSource Self}, 
                                   Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Red" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="SwitchBorder"
                                    Width="50" Height="24"
                                    CornerRadius="12"
                                    Background="#FF5252"
                                    BorderBrush="#CC0000"
                                    BorderThickness="1">
                                <Ellipse x:Name="SwitchKnob"
                                         Width="18" Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>

                            <ContentPresenter Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              Margin="10,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#388E3C"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Courier ID:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Joined At:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Full Name:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Email:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Phone Number:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Password:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Max Distance:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Transportation:" Margin="0,5,0,15" FontWeight="SemiBold"/>
                <TextBlock Text="Active Status:" Margin="0,5,0,15" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1">

                <TextBox Text="{Binding CurrentCourier.Id, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" 
                         IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>

                <DatePicker SelectedDate="{Binding CurrentCourier.JoinDate, Mode=TwoWay}"
                            IsEnabled="{Binding IsAddMode}"
                            Margin="0,0,0,10" Height="25"/>

                <TextBox Text="{Binding CurrentCourier.FullName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.Email, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.Password, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <TextBox Text="{Binding CurrentCourier.MaxDistancePreference, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                <ComboBox ItemsSource="{Binding Source={StaticResource TransportOptionsCollection}}"
                          SelectedValue="{Binding CurrentCourier.Transport, Mode=TwoWay}"
                          Height="25" Margin="0,0,0,10"
                          IsEnabled="{Binding CurrentCourier.ActiveOrder, Converter={StaticResource NullToBoolConverter}}"/>

                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay}" 
                          Margin="0,5,0,0"
                          IsEnabled="{Binding CurrentCourier.ActiveOrder, Converter={StaticResource NullToBoolConverter}}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding ButtonText}" Click="BtnSave_Click" 
                    Width="120" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>

            <!-- Open Active Order button: visible only when CurrentCourier.ActiveOrder is NOT null -->
            <Button Content="Open Active Order" Click="BtnOpenOrder_Click" Width="140" Height="35" Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- hide when no active order -->
                            <DataTrigger Binding="{Binding CurrentCourier.ActiveOrder}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="35"/>
        </StackPanel>
    </Grid>
</Window>