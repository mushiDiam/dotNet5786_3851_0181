<Window x:Class="PL.Courier.ForCourier.MainCourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:BO="clr-namespace:BO;assembly=BL"
        xmlns:local="clr-namespace:PL.Courier.ForCourier"
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="#F5F5F5">

    <Window.Resources>
        <ObjectDataProvider x:Key="TransportationKey" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="BO:Transportation"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#1565C0" Height="120" VerticalAlignment="Top">
            <Grid Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Courier Dashboard" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock Text="Personal workspace — manage profile, pick orders and view history" 
                                       FontSize="12" 
                                       Foreground="#E3F2FD"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#0D47A1" 
                            CornerRadius="8" 
                            Padding="20,10" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="CURRENT TIME" 
                                       FontSize="10" 
                                       Foreground="#90CAF9" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CurrentClock, StringFormat='{} {0:dd/MM/yyyy HH:mm}'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCourier.Id, StringFormat='ID: {0}'}"
                                       FontSize="12"
                                       Foreground="#BBDEFB"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Margin="20,140,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="🔧 Quick Actions" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"
                               Foreground="#333333"/>

                    <Button Content="Available Orders" Click="BtnAvailableOrders_Click" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- Hide when no CurrentCourier -->
                                    <DataTrigger Binding="{Binding CurrentCourier}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- Hide when courier is not active -->
                                    <DataTrigger Binding="{Binding CurrentCourier.IsActive}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Delivery History" Style="{StaticResource ModernButton}" Margin="0,0,0,8" Click="BtnDeliveryHistory_Click"/>
                    <Button Content="Logout" Click="BtnLogout_Click" Style="{StaticResource DangerButton}" Margin="0,280,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="🚚" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="My Workspace" 
                                   FontSize="20" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#333333"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12" Grid.RowSpan="3" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                    <TextBlock Text="PROFILE" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Name:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Phone:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Email:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                                        <TextBlock Width="110" Text="Password:" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MaskedPassword}" VerticalAlignment="Center" Width="160"/>
                                        <Button Content="Change" Width="60" Click="BtnChangePassword_Click" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Padding="4"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Transport:" VerticalAlignment="Center"/>
                                        <ComboBox Width="220"
                                                  ItemsSource="{Binding Source={StaticResource TransportationKey}}"
                                                  SelectedItem="{Binding CurrentCourier.Transport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Max Distance:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.MaxDistancePreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Join Date:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentCourier.JoinDate, StringFormat=d}" Width="150" IsEnabled="False" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Width="110" Text="Active:" VerticalAlignment="Center"/>
                                        <CheckBox IsChecked="{Binding CurrentCourier.IsActive}" IsEnabled="False" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="6" Padding="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentCourier.ActiveOrder}" Value="{x:Null}">
                                                    <Setter Property="Background" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="CURRENT DELIVERY" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>

                                        <StackPanel Margin="0,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentCourier.ActiveOrder}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding CurrentCourier.ActiveOrder.OrderId, StringFormat='Order ID: {0}'}" FontSize="13" Margin="0,2"/>
                                            <TextBlock Text="{Binding CurrentCourier.ActiveOrder.Address, StringFormat='Address: {0}'}" FontSize="13" Margin="0,2" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CurrentCourier.ActiveOrder.ScheduleStatus, StringFormat='Status: {0}'}" FontSize="13" Margin="0,6"/>
                                            <TextBlock Text="{Binding CurrentCourier.ActiveOrder.CustomerName, StringFormat='Customer: {0}'}" FontSize="13" Margin="0,2"/>
                                            <TextBlock Text="{Binding CurrentCourier.ActiveOrder.TimeLeftForDelivery, StringFormat='Time left: {0}'}" FontSize="13" Margin="0,2"/>

                                            <!-- Buttons row: same line horizontally, smaller buttons, visible only when ActiveOrder exists -->
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentCourier.ActiveOrder}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button x:Name="BtnMarkCancelled"
                                                        Content="Cancelled"
                                                        Click="BtnMarkCancelled_Click"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="84" Height="32" FontSize="12" Padding="6"
                                                        Margin="0,0,8,0"/>

                                                <Button x:Name="BtnMarkCompleted"
                                                        Content="Completed"
                                                        Click="BtnMarkCompleted_Click"
                                                        Style="{StaticResource SuccessButton}"
                                                        Width="84" Height="32" FontSize="12" Padding="6"
                                                        Margin="0,0,8,0"/>

                                                <Button x:Name="BtnMarkUnreached"
                                                        Content="Unreached"
                                                        Click="BtnMarkUnreached_Click"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="84" Height="32" FontSize="12" Padding="6"/>
                                            </StackPanel>

                                        </StackPanel>

                                        <TextBlock Text="No current delivery." Foreground="#777" FontStyle="Italic" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentCourier.ActiveOrder}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Save profile button (always visible) -->
        <Button x:Name="BtnSaveProfileFixed"
                Content="💾 Save Profile"
                Click="BtnSave_Click"
                Style="{StaticResource SuccessButton}"
                Width="140" Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                ToolTip="Save profile (always visible)"/>
    </Grid>
</Window>