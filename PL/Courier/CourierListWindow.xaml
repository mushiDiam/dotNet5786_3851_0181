<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier List" Height="640" Width="800"
        FlowDirection="LeftToRight">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Filter by Courier Status:" 
                   Grid.Column="0" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0"/>

            <ComboBox Grid.Column="1" 
                      VerticalAlignment="Center"
                      HorizontalAlignment="Stretch"/>
        </Grid>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Path=CourierInList}"
                  SelectedItem="{Binding SelectedCourier}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  MouseDoubleClick="dgCourierList_MouseDoubleClick"
                  Margin="10"
                  BorderBrush="Gray" 
                  BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding FullName}" Header="Full Name" Width="*"/>

                <DataGridTemplateColumn Header="Active" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsEnabled="False" 
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding Path=IsActive}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding DeliveryType}" Header="Delivery Type" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding JoinDate, StringFormat=\{0:yyyy-MM-dd\}}" Header="Join Date" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding OrdersOnTime}" Header="On Time" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding OrdersLate}" Header="Late" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding CurrentOrderId}" Header="Current Order" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Add New Courier" 
                Grid.Row="2" 
                HorizontalAlignment="Center" 
                Height="40" 
                Width="150"
                Margin="10"
                FontSize="14"
                FontWeight="Bold"/>
    </Grid>
</Window>