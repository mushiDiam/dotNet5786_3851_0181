<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL" 
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier Management" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ObjectDataProvider x:Key="SortOptionsCollection" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:CourierInListOptions"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registered Couriers" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="Sort by:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox Width="150" 
                          ItemsSource="{Binding Source={StaticResource SortOptionsCollection}}"
                          SelectedItem="{Binding SelectedSort}"
                          VerticalContentAlignment="Center"/>

                <Button Content="X" Width="30" ToolTip="Clear Sort" Click="btnClearSort_Click"/>
            </StackPanel>

            <Button Grid.Column="2" Content="+ Add New Courier" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="btnAddCourier_Click"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding CourierInList}"
                  SelectedItem="{Binding SelectedCourier}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="dgCourierList_MouseDoubleClick"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="btnDeleteCourier_Click" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Delete Courier">

                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                      Fill="Red" 
                                      Height="15" Width="15" 
                                      Stretch="Uniform"/>

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>

                <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="100"/>

                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                <DataGridTextColumn Header="On Time" Binding="{Binding OrdersOnTime}" Width="80"/>
                <DataGridTextColumn Header="Late" Binding="{Binding OrdersLate}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>