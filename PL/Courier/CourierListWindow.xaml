<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL" 
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier Management" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registered Couriers" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">

                <TextBlock Text="Sort by:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox x:Name="cbSort" 
                          Width="130" 
                          ItemsSource="{Binding Source={StaticResource CourierInListOptionsKey}}"
                          SelectedValue="{Binding Path=SelectedSort, Mode=TwoWay}"
                          SelectionChanged="cbSort_SelectionChanged"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="Filter Transport:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,10,0"/>

                <ComboBox x:Name="cbFilter" 
                          Width="130" 
                          ItemsSource="{Binding Source={StaticResource TransportationKey}}"
                          SelectedValue="{Binding Path=TransportFilter, Mode=TwoWay}"
                          SelectionChanged="cbTransport_SelectionChanged"
                          VerticalContentAlignment="Center"/>

                <Button Content="X" Width="30" ToolTip="Clear Filters" Click="btnClearSort_Click"/>
            </StackPanel>

            <Button Grid.Column="2" Content="+ Add New Courier" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="btnAddCourier_Click"/>
        </Grid>

        <DataGrid Grid.Row="2"
          ItemsSource="{Binding CourierInList}"
          SelectedItem="{Binding SelectedCourier}"
          MouseDoubleClick="dgCourierList_MouseDoubleClick"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          CanUserAddRows="False"
          GridLinesVisibility="Horizontal"
          RowHeaderWidth="0">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="btnDeleteCourier_Click" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Delete Courier">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                              Fill="Red" 
                              Height="15" Width="15" 
                              Stretch="Uniform"/>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>

                <DataGridTemplateColumn Header="Full Name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Transport" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Transport}" 
                                       Foreground="DarkBlue" 
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Active" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusToIconKey}}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="On Time" Binding="{Binding OrdersOnTime}" Width="80"/>

                <DataGridTemplateColumn Header="Late" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OrdersLate}" 
                               Foreground="Red" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>