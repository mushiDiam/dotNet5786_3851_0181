<Window x:Class="PL.Deliveries.DeliveriesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Deliveries"
        mc:Ignorable="d"
        Title="Delivery List" Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/PL;component/Helpers/app.ico"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da190b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#1565C0" Height="96" VerticalAlignment="Top">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚚" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Delivery List" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="View ongoing and completed deliveries" FontSize="12" Foreground="#E3F2FD"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="White" CornerRadius="10" Padding="18" Margin="20,120,20,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Overview of shipments" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryItems}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemHeight="46" ItemWidth="220"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" 
                                    Click="SummaryButton_Click" 
                                    Style="{StaticResource ModernButton}" 
                                    Margin="4"
                                    VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8" >
                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="220" Margin="0,0,16,0" 
                              ItemsSource="{Binding SortOptionsList}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>

                    <TextBlock Text="Filter by:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="220" Margin="0,0,8,0" 
                              ItemsSource="{Binding FilterOptionsList}"
                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>

                    <Button Content="Clear" Width="80" Click="BtnClearFilterSort_Click" Style="{StaticResource ModernButton}" Margin="8,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="4" 
                          ItemsSource="{Binding DeliveryItems}"
                          SelectedItem="{Binding SelectedDelivery, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          RowHeight="30"
                          MouseDoubleClick="dgDeliveries_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding OrderId}" Width="60"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140"/>
                        <DataGridTextColumn Header="Courier" Binding="{Binding CourierName}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Picked Up" Binding="{Binding PickedUp, StringFormat='{}{0:dd/MM HH:mm}'}" Width="110"/>
                        <DataGridTextColumn Header="Delivered" Binding="{Binding Delivered, StringFormat='{}{0:dd/MM HH:mm}'}" Width="110"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Width="110" Margin="0,0,8,0" Click="BtnRefresh_Click" Style="{StaticResource ModernButton}"/>
                    <Button Content="Close" Width="100" Click="BtnClose_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>